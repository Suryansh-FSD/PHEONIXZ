# ============================================================
# PHOENIXZ — Environment Variables Reference (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit real credentials or .env.local to version control.
# ============================================================

# ─── Supabase Configuration ──────────────────────────────────
# Required: Public URL of your Supabase project (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required: Public anonymous API key for client-side queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required: Confidential service role key for admin DB access (SERVER ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── AI Provider Credentials & Fallback Chain ────────────────
# Primary LLM Provider (groq | gemini | openrouter | agentrouter)
AI_PRIMARY_PROVIDER=groq

# Provider Fallback Order (comma-separated fallback chain)
AI_PROVIDER_ORDER=groq,gemini,openrouter

# Groq API (Primary fast inference)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Secondary fallback)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# OpenRouter API (Tertiary fallback)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# AgentRouter / Anthropic Gateway (Quaternary fallback)
AGENT_ROUTER_API_KEY=your-agent-router-api-key
AGENT_ROUTER_BASE_URL=https://co.agentrouter.org
AGENT_ROUTER_MODEL=claude-opus-5

ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
ANTHROPIC_BASE_URL=https://co.agentrouter.org
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Breeth AI Cognitive Memory (Vector Space) ───────────────
# API Key for Breeth vector memory storage & retrieval
BREETH_API_KEY=your-breeth-api-key

# Project ID for Breeth vector space isolation
BREETH_PROJECT_ID=your-breeth-project-id

# Base URL for Breeth MCP server
BREETH_BASE_URL=https://mcp.thebreeth.com

# ─── Security & Cron Protection ──────────────────────────────
# Shared secret for authorizing autonomous cycle triggers (/api/internal/cycle)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-32-hex-bytes

# ─── App Configuration ───────────────────────────────────────
# Public app deployment URL (e.g., https://phoenixz.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate Limiting & Cooldown Cadence ────────────────────────
# Minimum cooldown hours between published intelligence briefs (default: 2)
PUBLISH_COOLDOWN_HOURS=2
# Alternative cooldown override in minutes (default: 120)
PUBLISH_COOLDOWN_MINUTES=120

# ─── Autonomous Scheduler Config ──────────────────────────────
# Milliseconds between autonomous cycle ticks (default: 600000 = 10 minutes)
AUTONOMOUS_INTERVAL_MS=600000

# Set to false on serverless hosts (Vercel) to rely on external Vercel Cron
AUTONOMOUS_SCHEDULER_ENABLED=false
